datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// de que billetera viene la captura
enum PaymentSource {
  YAPE
  PLIN
}

// si el dinero entro o salio
enum PaymentDirection {
  INCOMING
  OUTGOING
}

// La imagen no se almacena: solo lo que se leyo de ella. Por eso la fila
// nace ya completa, despues de una extraccion exitosa, y todo es obligatorio.
model Payment {
  id String @id @default(cuid())

  // null en el detalle de movimiento de Interbank, que no lo muestra
  operationCode String?
  source        PaymentSource
  direction     PaymentDirection
  amount        Decimal          @db.Decimal(10, 2)
  operatedAt    DateTime

  // id del catalogo de modelos (src/lib/ai-models.ts) que leyo la captura,
  // para poder comparar despues que modelo se equivoca menos
  model String

  createdAt DateTime @default(now())

  // la misma constancia no entra dos veces. Postgres no compara los null entre
  // si, asi que las filas sin codigo se deduplican en save-payment.ts
  @@unique([source, operationCode])
}
